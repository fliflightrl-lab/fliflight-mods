{
  "schemaVersion": 1,
  "id": "pvphud",
  "version": "${version}",
  "name": "PvP HUD",
  "description": "Client-side PvP HUD for Minecraft: FPS, ping, coordinates and clicks-per-second (CPS) in the top-left corner. All lines toggleable via config.",
  "authors": ["Fliflightmc"],
  "contact": {
    "homepage": "https://github.com/fliflightrl-lab/fliflight-mods",
    "sources": "https://github.com/fliflightrl-lab/fliflight-mods"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["com.fliflight.pvphud.PvPHudClient"]
  },
  "mixins": [
    "pvphud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
